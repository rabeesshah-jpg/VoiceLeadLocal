# LiveKit worker on RunPod (same 4090 instance as TTS server).
# Copy to .env on the RunPod pod, or source before: python -m agent start
#
# TTS runs locally on the pod — never use the public RunPod IP here.

WORKER_ENV=runpod
# CPU-only for this process. run_runpod_worker.sh sets CUDA_VISIBLE_DEVICES=""
# for the worker only — TTS server (separate process) keeps GPU access.
WORKER_CPU_ONLY=true

# Shared cloud Postgres (same DATABASE_URL as Django API in production)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Realtime pipeline — remote APIs only (no local Whisper/GPU STT on worker)
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
# Do not set STT_WS_URL / FASTER_WHISPER_* on RunPod worker.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Alias supported: VOICE_AGENT_LLM_MODEL=openai/gpt-4o-mini

# Local TTS on the same RunPod instance
TTS_BASE_URL=http://127.0.0.1:7788
TTS_HEALTH_URL=http://127.0.0.1:7788/v1/health
TTS_PROVIDER=supertonic
TTS_VOICE=M1
TTS_LANG=en

VOICE_AGENT_NAME=voice-agent
