# =============================================================================
# Django API — local or cloud (CPU). Does NOT run realtime STT/LLM/TTS.
# Copy: cp .env.example .env
# =============================================================================

DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
VOICE_AGENT_DEV_API_KEY=dev-local-key

# Database: omit for local SQLite; set for shared cloud Postgres (same as RunPod worker).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# LiveKit Cloud — room creation, tokens, agent dispatch
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VOICE_AGENT_NAME=voice-agent
VOICE_AGENT_TOKEN_TTL_SECONDS=1800

# -----------------------------------------------------------------------------
# Worker-only settings below are OPTIONAL on Django API.
# Omit them when Django runs outside RunPod; the LiveKit worker loads its own .env.
# Set them only for local all-in-one dev (Django + worker on same machine).
# -----------------------------------------------------------------------------

# STT_PROVIDER=deepgram
# DEEPGRAM_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# VOICE_AGENT_LLM_MODEL=openai/gpt-4o-mini

# TTS — worker calls http://127.0.0.1:7788 on RunPod. Do not set on cloud Django API.
# TTS_PROVIDER=supertonic
# TTS_BASE_URL=http://127.0.0.1:7788
# TTS_VOICE=M1
# TTS_LANG=en

# Voice profiles (local Django → RunPod TTS public URL). Worker uses 127.0.0.1:7788 on pod.
# VOICE_PROFILE_TTS_BASE_URL=http://<RUNPOD_PUBLIC_IP>:<PORT>
# TTS_VOICE_CLONING_ENABLED=true

# Local dev shortcuts
# VOICE_AGENT_SKIP_ROOM_SETUP=false
# VOICE_AGENT_SKIP_TTS_WARMUP=true

# --- RunPod worker env template: see .env.runpod.example ---
