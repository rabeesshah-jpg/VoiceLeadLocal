DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
VOICE_AGENT_DEV_API_KEY=dev-local-key

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# STT: deepgram (cloud) or faster_whisper / wlk (self-hosted GPU)
STT_PROVIDER=faster_whisper
# Self-hosted Faster Whisper (STT only — not TTS)
STT_BASE_URL=http://172.16.2.158:8000
STT_WS_URL=ws://172.16.2.158:8000/asr
STT_LANGUAGE=en
# Reject garbled / one-word STT finals before UI+LLM (default min 2 words)
# VOICE_AGENT_STT_MIN_FINAL_CHARS=3
# VOICE_AGENT_STT_MIN_FINAL_WORDS=2
# Debounce STT finals before UI/LLM commit (ms). Default 0 for deepgram, 200 for faster_whisper.
# VOICE_AGENT_STT_FINAL_STABILITY_MS=0
# Allow listening state during active LLM/TTS (barge-in). Default false.
# VOICE_AGENT_BARGE_IN_ENABLED=false
# Server-side (WhisperLiveKit CLI): --model small --language en --pcm-input
# FASTER_WHISPER_MODEL=small
# FASTER_WHISPER_COMPUTE_TYPE=float16
# Aliases (optional; STT_WS_URL / STT_BASE_URL take precedence when set)
# FASTER_WHISPER_STT_URL=http://localhost:8000
# FASTER_WHISPER_LANGUAGE=auto
# FASTER_WHISPER_STREAMING=true
# FASTER_WHISPER_TIMEOUT_SECONDS=30
# FASTER_WHISPER_SEND_CONFIG=false
# STT_WS_MODE=full

# Deepgram (only when STT_PROVIDER=deepgram)
DEEPGRAM_API_KEY=
# Legacy alias (optional): VOICE_AGENT_STT_PROVIDER=faster_whisper
# Deepgram is opt-in only — set STT_PROVIDER=deepgram and DEEPGRAM_API_KEY
# VOICE_AGENT_STT_SAMPLE_RATE=16000
# VOICE_AGENT_AUDIO_FRAME_SIZE_MS=20
# VOICE_AGENT_AUDIO_PRE_CONNECT=true
# VOICE_AGENT_STT_WARMUP_SILENCE_MS=80
# Max wait after VAD flush for WLK ready_to_stop before forcing FINAL (ms)
# VOICE_AGENT_STT_FLUSH_FINAL_TIMEOUT_MS=2000
# Finalize partial when text stops changing (ms, clamped 600–900)
# VOICE_AGENT_STT_PARTIAL_FINALIZE_MS=750
# VOICE_AGENT_SKIP_STT_WARMUP=false
# VOICE_AGENT_AEC_WARMUP_S=1.0
# VOICE_AGENT_DEEPGRAM_MODEL=nova-3
# User STT locale override (normally auto: en-US for English calls, ar-SA/en-US routing for Arabic calls).
# VOICE_AGENT_DEEPGRAM_LANGUAGE=en-US
# Deepgram silence before STT final (ms). 75 = aggressive; 100–150 balanced; 300+ long pauses.
# VOICE_AGENT_DEEPGRAM_ENDPOINTING_MS=75
# VOICE_AGENT_DEEPGRAM_SMART_FORMAT=false
# VOICE_AGENT_DEEPGRAM_FILLER_WORDS=false
# VOICE_AGENT_DEEPGRAM_PUNCTUATE=true
# Optional regional edge: VOICE_AGENT_DEEPGRAM_BASE_URL=https://api.deepgram.com/v1/listen
# AgentSession endpointing window (seconds) after VAD/Deepgram hint.
# VOICE_AGENT_MIN_ENDPOINTING_DELAY=0.05
# VOICE_AGENT_MAX_ENDPOINTING_DELAY=0.25
# Silero VAD: silence before speech-end (seconds). 0.2 = aggressive; 0.3+ for mid-sentence pauses.
# VOICE_AGENT_VAD_MIN_SILENCE_S=0.2
# Deepgram aggressive low-latency profile (STT_PROVIDER=deepgram):
# VOICE_AGENT_STT_FINAL_STABILITY_MS=0
# VOICE_AGENT_STT_WARMUP_SILENCE_MS=50
# VOICE_AGENT_VAD_MIN_SPEECH_S=0.03
# VOICE_AGENT_VAD_ACTIVATION_THRESHOLD=0.5
# Legacy ms alias: VAD_SILENCE_TIMEOUT_MS=400
# Synthetic speech-end on commit (off = use real USER_SPEECH_END for metrics)
# VOICE_AGENT_LATENCY_SYNTHETIC_SPEECH_END=false
# Preemptive LLM/TTS (default off for faster_whisper — finals are debounced in entrypoint)
# VOICE_AGENT_PREEMPTIVE_GENERATION=true
# VOICE_AGENT_PREEMPTIVE_TTS=true
# VOICE_AGENT_PREEMPTIVE_MAX_RETRIES=10
# Interim STT → PREFLIGHT for early LLM (Deepgram v1 has no native preflight).
# VOICE_AGENT_PARTIAL_STT_PREEMPTIVE=true
# VOICE_AGENT_PARTIAL_STT_MIN_CHARS=6
# VOICE_AGENT_PARTIAL_STT_MIN_GROWTH_CHARS=3
# VOICE_AGENT_PARTIAL_STT_MIN_INTERVAL_MS=150
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VOICE_AGENT_LLM_MODEL=openai/gpt-4o-mini
# Publish caller chat lines in English (translate via OpenRouter); set false to show raw STT.
# VOICE_AGENT_USER_UI_ENGLISH=true
# VOICE_AGENT_TRANSLATE_MODEL=openai/gpt-4o-mini

# Supertonic-3 (pip install 'supertonic[serve]' && supertonic serve --port 7788)
TTS_PROVIDER=supertonic
TTS_BASE_URL=http://172.16.2.158:7788
TTS_MODEL=supertonic-3
TTS_VOICE=M1
TTS_LANG=en
# Voice cloning (RunPod Supertonic POST /v1/voices/clone)
TTS_VOICE_CLONING_ENABLED=true
TTS_CLONE_ENDPOINT=/v1/voices/clone
TTS_SYNTH_ENDPOINT=/v1/tts
TTS_TIMEOUT=60
TTS_CLONE_TIMEOUT_SECONDS=120
# TTS_CLONE_POLL_TIMEOUT_SECONDS=90
# TTS_CLONE_POLL_INTERVAL_SECONDS=2
# TTS_CLONE_MAX_BYTES=15728640
# TTS_CLONE_ALLOWED_EXTENSIONS=wav,webm,mp3,m4a
# Omit or 0 to avoid Supertonic server splitting one sentence into multiple synth chunks.
# TTS_MAX_CHUNK_LENGTH=0
VOICE_AGENT_TTS_STREAM_PHRASES=true
# Emit TTS only at . ! ? (not commas). Do not set max chars low — that caused mid-sentence pauses.
VOICE_AGENT_TTS_MIN_TEXT_CHARS=8
VOICE_AGENT_TTS_MAX_TEXT_CHARS=2000
# Shorter gaps between sentences: trim TTS tail/head silence, prefetch next sentence (1-3)
VOICE_AGENT_TTS_TRIM_PHRASE_SILENCE=true
VOICE_AGENT_TTS_MAX_TRAILING_TRIM_MS=180
VOICE_AGENT_TTS_MAX_LEADING_TRIM_MS=80
VOICE_AGENT_TTS_PHRASE_PREFETCH=2

# Multilingual TTS (POST /tts_to_audio/)
# TTS_PROVIDER=multilingual
# TTS_BASE_URL=http://157.157.221.29:30039
# TTS_VOICE=female

# --- Deprecated Chatterbox ---
# CHATTERBOX_TTS_URL=

VOICE_AGENT_TOKEN_TTL_SECONDS=1800
# VOICE_AGENT_SKIP_TTS_WARMUP=false
